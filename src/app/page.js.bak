          style={{
            backgroundColor: COLORS.pink,
            boxShadow: "0 6px 0 rgba(0,0,0,0.15)",
          }}
        >
          <Play className="w-9 h-9" />
          <span className="font-black text-lg">{t.play}</span>
          <span className="text-xs font-semibold opacity-90 text-center">
            {t.playDesc}
          </span>
